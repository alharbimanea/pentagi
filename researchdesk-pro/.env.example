# ResearchDesk Pro — copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser; everything else is server-only.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | production. Defaults to production for a production build.
# Only "production" hides the sandbox gateway and unverified payment adapters and makes
# a missing Turnstile secret fail closed; use "preview" for staging/preview servers.
APP_STAGE=

# Supabase project (Settings → API). The service-role key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: how this server reaches Supabase when it differs from the browser-facing URL
# (e.g. http://127.0.0.1:54321 behind a reverse proxy on the same host).
SUPABASE_INTERNAL_URL=

# Google sign-in: enable the provider in Supabase Auth first, then set to true.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudflare Turnstile. Without a secret, checks pass in development and FAIL in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email (Resend). Without a key, notification emails are marked "skipped".
RESEND_API_KEY=
EMAIL_FROM="ResearchDesk Pro <no-reply@your-domain.example>"
SUPPORT_EMAIL=support@your-domain.example

# Protects /api/cron/* — at least 24 random characters (openssl rand -hex 32).
CRON_SECRET=
# Salt for hashing IPs in rate-limit keys — at least 16 random characters.
IP_HASH_SALT=

# Malware scanning: a clamav-rest compatible endpoint. Unset = files marked not_scanned.
CLAMAV_REST_URL=

# OpenAI assistance (also requires app_config.ai_assist_enabled = true and per-order consent).
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Payments (online only; no bank transfer path exists) ---
# Sandbox gateway for development, preview and acceptance tests. Refused when APP_STAGE is production.
PAYMENTS_SANDBOX_ENABLED=true
SANDBOX_WEBHOOK_SECRET=

# Moyasar (cards, mada, Apple Pay, STC Pay). UNVERIFIED adapter: hidden in production until verified.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# --- Messaging channels (inactive until configured and tested) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
